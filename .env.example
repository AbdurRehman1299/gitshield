# ---------------------------------------------------------------------------
# GitShield environment configuration
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# When running via docker compose this is overridden automatically, but you can
# use the same value for local development if you run Postgres yourself.
DATABASE_URL="postgresql://gitshield:gitshield@localhost:5432/gitshield?schema=public"

# --- Groq (required for AI-powered analysis) --------------------------------
# Get a free key at https://console.groq.com/keys
# If this is empty GitShield still works using the built-in regex/heuristic
# scanner, but AI remediation advice and semantic detection are disabled.
GROQ_API_KEY=""

# Model used for analysis. Good free-tier options:
#   llama-3.3-70b-versatile   (best quality)
#   llama-3.1-8b-instant      (fastest / cheapest)
GROQ_MODEL="llama-3.3-70b-versatile"
# Fallback model used if the primary model errors out.
GROQ_FALLBACK_MODEL="llama-3.1-8b-instant"

# --- GitHub (optional) -------------------------------------------------------
# A personal access token is NOT required for public repositories, but raises
# the API rate limit from 60 to 5000 requests/hour. Leave blank if unused.
GITHUB_TOKEN=""

# --- Scanner limits ----------------------------------------------------------
# Guard rails so a huge repository cannot exhaust memory or the Groq quota.
MAX_REPO_FILES="40"
MAX_FILE_BYTES="102400"
MAX_TOTAL_BYTES="2097152"
MAX_GROQ_CHARS="24000"
